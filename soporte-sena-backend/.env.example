NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=soporte_sena
DB_USER=root
DB_PASSWORD=

JWT_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio

LOG_LEVEL=info

# Deja sin definir (o "false") si ya corriste database/schema.sql a mano.
# Ponla en "true" solo para arranque rapido en desarrollo; Sequelize no
# replica exactamente las reglas ON DELETE del schema (ver README).
DB_AUTO_SYNC=false

# URL publica del frontend. Se usa para el codigo QR (apunta aqui) y para
# los enlaces de invitacion/restablecimiento que se mandan por correo.
FRONTEND_URL=http://localhost:5173

# Envio de invitaciones y restablecimiento de contrasena por SMTP (nodemailer).
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, y como SMTP_PASS
# una "Contrasena de aplicacion" generada en la cuenta Google (requiere 2FA).
# Sin estas variables, los correos se registran en el log en vez de enviarse
# de verdad (util en desarrollo, ver src/utils/mailer.js).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional: remitente visible distinto al usuario SMTP (por defecto = SMTP_USER)
# SMTP_FROM=
