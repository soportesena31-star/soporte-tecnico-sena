NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=soporte_sena
DB_USER=root
DB_PASSWORD=

JWT_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio

LOG_LEVEL=info

# Deja sin definir (o "false") si ya corriste database/schema.sql a mano.
# Ponla en "true" solo para arranque rapido en desarrollo; Sequelize no
# replica exactamente las reglas ON DELETE del schema (ver README).
DB_AUTO_SYNC=false

# URL publica del frontend. Se usa para el codigo QR (apunta aqui) y para
# los enlaces de invitacion/restablecimiento que se mandan por correo.
FRONTEND_URL=http://localhost:5173

# Resend (https://resend.com) - envio de invitaciones y restablecimiento
# de contrasena. Sin RESEND_API_KEY, los correos se registran en el log
# en vez de enviarse de verdad (util en desarrollo, ver src/utils/mailer.js).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Soporte SENA <onboarding@resend.dev>
